# Required in production. Never commit the real value.
MISTRAL_API_KEY=

# Optional: models the API accepts, comma separated (default: the three Ministral models,
# the only ones Mistral's free tier serves). With pay-as-you-go, larger models can be added:
# ALLOWED_MODELS=mistral-medium-latest,mistral-small-latest,ministral-8b-2512

# Local development without a key: stream a canned answer instead of calling Mistral.
# Ignored whenever MISTRAL_API_KEY is set.
# MOCK_MISTRAL=1
