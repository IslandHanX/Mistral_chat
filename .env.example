# Required in production. Never commit the real value.
MISTRAL_API_KEY=

# Optional: models the API accepts, comma separated (default: small and medium).
# ALLOWED_MODELS=mistral-small-latest,mistral-medium-latest

# Local development without a key: stream a canned answer instead of calling Mistral.
# Ignored whenever MISTRAL_API_KEY is set.
# MOCK_MISTRAL=1
